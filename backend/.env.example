APP_NAME=AtlasAI
APP_VERSION=0.2.0
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=sqlite:///./atlas_ai.db
AUTH_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_DOCUMENT_SIZE_BYTES=5000000
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=120
OCR_LANGUAGE=eng
REDIS_URL=redis://localhost:6379/0
DOCUMENT_STORAGE_BACKEND=local
LOCAL_DOCUMENT_STORAGE_PATH=./document_uploads
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=atlas-documents
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
